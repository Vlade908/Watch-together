# Database Connection (PostgreSQL 16 com extensão pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/watch_together?schema=public"

# Redis Cache & Pub/Sub
REDIS_URL="redis://localhost:6379"

# Servidor WebSocket & API
PORT=4000
WS_PORT=4001
JWT_SECRET="super-secret-watch-together-key-change-in-production"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4001"

# Storage CDN (Cloudflare R2 / S3 ou Local para desenvolvimento)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./media_output"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="watch-together-vod"
R2_PUBLIC_DOMAIN=""
