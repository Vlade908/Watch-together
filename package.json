{
  "name": "watch-together",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,WEB\" -c \"magenta,cyan\" \"npm run server:dev\" \"npm run dev --workspace=@watch-together/web\"",
    "dev:all": "concurrently -n \"SERVER,WEB,ML\" -c \"magenta,cyan,yellow\" \"npm run server:dev\" \"npm run dev --workspace=@watch-together/web\" \"npm run ml:dev\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "ci:local": "npm run db:generate && npm run typecheck && npm run server:build && npm run build --workspace=@watch-together/web",
    "pre-push": "npm run ci:local",
    "db:generate": "npm run db:generate --workspace=@watch-together/database",
    "db:migrate": "npm run db:migrate --workspace=@watch-together/database",
    "db:studio": "npm run db:studio --workspace=@watch-together/database",
    "server:dev": "npm run dev --workspace=@watch-together/server",
    "server:build": "npm run build --workspace=@watch-together/server",
    "server:start": "npm run start --workspace=@watch-together/server",
    "ml:compile": "python3 -m py_compile watch-together-ml/src/*.py watch-together-ml/src/**/*.py",
    "ml:dev": "watch-together-ml/.venv/Scripts/uvicorn src.main:app --host 0.0.0.0 --port 8000 --reload --app-dir watch-together-ml",
    "ml:retrain": "powershell -Command \"Invoke-RestMethod -Method POST -Uri 'http://localhost:8000/retrain'\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.7.3"
  }
}
